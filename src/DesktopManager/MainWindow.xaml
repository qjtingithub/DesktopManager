<Window x:Class="DesktopManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopManager 可行性 Demo"
        Width="720"
        Height="760"
        MinWidth="620"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Background="#FFF4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1F2937" Padding="24,20">
            <StackPanel>
                <TextBlock Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="DesktopManager 可行性 Demo" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#FFD1D5DB"
                           Text="验证真实桌面图标枚举、半透明分区，以及拖动分区时同步移动一个指定测试图标。" />
            </StackPanel>
        </Border>

        <Border x:Name="StatusBorder"
                Grid.Row="1"
                Margin="20,16,20,0"
                Padding="12"
                Background="#FFE5EEF9"
                BorderBrush="#FF7AA7D9"
                BorderThickness="1"
                CornerRadius="5">
            <TextBlock x:Name="StatusText"
                       Foreground="#FF173B63"
                       Text="正在连接 Windows 桌面……" />
        </Border>

        <StackPanel Grid.Row="2" Margin="20,18,20,8">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="1. Shell 与分区窗口" />
            <WrapPanel Margin="0,10,0,0">
                <Button Content="刷新桌面图标" Click="RefreshButton_OnClick" />
                <Button Content="打开 / 显示分区" Click="OpenRegionButton_OnClick" />
                <Button Content="定位到测试图标" Click="LocateRegionButton_OnClick" />
            </WrapPanel>

            <TextBlock Margin="0,8,0,3"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="2. 仅限临时测试快捷方式" />
            <TextBlock Foreground="#FF596273"
                       Text="安全边界：Demo 只接受桌面上的 DesktopManager.FeasibilityTest.lnk，不会移动、复制、删除或重命名真实文件。" />
            <TextBox x:Name="TestShortcutPathTextBox"
                     Margin="0,8,0,10"
                     Padding="8,6"
                     IsReadOnly="True" />
            <WrapPanel>
                <Button x:Name="CaptureButton"
                        MinWidth="170"
                        Content="捕获方框内的测试图标"
                        Click="CaptureButton_OnClick" />
                <Button x:Name="RestoreButton"
                        MinWidth="140"
                        Content="恢复测试图标原位置"
                        Click="RestoreButton_OnClick" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="3"
                Margin="20,0,20,12"
                Padding="12"
                Background="White"
                BorderBrush="#FFD4D9E1"
                BorderThickness="1"
                CornerRadius="5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="Explorer 当前返回的桌面图标" />
                <ListBox x:Name="DesktopIconsList"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12" />
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Background="#FFE9EDF2" Padding="20,12">
            <TextBlock Foreground="#FF4B5563">
                <Run FontWeight="SemiBold" Text="操作顺序：" />
                <Run Text="打开分区 → 将测试图标拖入分区（锁定后可穿透），或用“定位”按钮 → Ctrl+Alt+E 回到编辑模式 → 捕获 → 拖动分区。关闭分区或主窗口时会尝试恢复原坐标。" />
            </TextBlock>
        </Border>
    </Grid>
</Window>
