<Window x:Class="DesktopManager.UI.DesktopRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop region"
        Width="330"
        Height="190"
        MinWidth="220"
        MinHeight="120"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ColorPresetButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D9FFFFFF" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="2">
        <Border x:Name="Surface"
                BorderThickness="2"
                CornerRadius="8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar"
                        Grid.Row="0"
                        Padding="10,0,8,0"
                        CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TitleEditor"
                                 Grid.Column="0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Padding="0"
                                 TextChanged="TitleEditor_OnTextChanged"
                                 LostFocus="TitleEditor_OnLostFocus" />

                        <TextBlock x:Name="TitleText"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel x:Name="EditControls"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#E6FFFFFF"
                                       FontSize="11"
                                       Text="透明度" />
                            <Slider x:Name="OpacitySlider"
                                    Width="66"
                                    Margin="4,0,2,0"
                                    Minimum="0.12"
                                    Maximum="0.85"
                                    SmallChange="0.02"
                                    LargeChange="0.1"
                                    ValueChanged="OpacitySlider_OnValueChanged" />
                            <TextBlock x:Name="OpacityValueText"
                                       Width="30"
                                       VerticalAlignment="Center"
                                       Foreground="#E6FFFFFF"
                                       FontSize="10"
                                       TextAlignment="Right" />
                            <Button Style="{StaticResource ColorPresetButton}"
                                    Background="#FF2F80ED"
                                    Tag="#2F80ED"
                                    ToolTip="蓝色"
                                    Click="ColorPreset_OnClick" />
                            <Button Style="{StaticResource ColorPresetButton}"
                                    Background="#FF27AE60"
                                    Tag="#27AE60"
                                    ToolTip="绿色"
                                    Click="ColorPreset_OnClick" />
                            <Button Style="{StaticResource ColorPresetButton}"
                                    Background="#FFF2994A"
                                    Tag="#F2994A"
                                    ToolTip="橙色"
                                    Click="ColorPreset_OnClick" />
                            <Button Style="{StaticResource ColorPresetButton}"
                                    Background="#FF9B51E0"
                                    Tag="#9B51E0"
                                    ToolTip="紫色"
                                    Click="ColorPreset_OnClick" />
                            <Button Width="38"
                                    Height="22"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    Content="锁定"
                                    ToolTip="锁定分区（Ctrl+Alt+E 恢复编辑）"
                                    Click="LockButton_OnClick" />
                        </StackPanel>

                        <TextBlock x:Name="LockedHint"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="#E6FFFFFF"
                                   FontSize="10"
                                   Text="已锁定 · Ctrl+Alt+E 编辑"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="12,8,12,12">
                    <TextBlock Foreground="#CCFFFFFF"
                               FontSize="12"
                               Text="Demo 分区&#x0a;图标成员由 Shell 集成层提供"
                               TextWrapping="Wrap" />
                </Grid>

                <Thumb x:Name="ResizeThumb"
                       Grid.Row="1"
                       Width="18"
                       Height="18"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,2,2"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_OnDragDelta" />
            </Grid>
        </Border>
    </Grid>
</Window>
